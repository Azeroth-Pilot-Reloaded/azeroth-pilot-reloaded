package-as: APR
enable-toc-creation: yes

required-dependencies:
  - libtaxidata

# Terrain export replaces only this block with discovered sibling addon moves.
# APR-TERRAIN-MOVES-BEGIN
move-folders:
  APR/NavigationData/APR_NavData_Retail_0: APR_NavData_Retail_0
  APR/NavigationData/APR_NavData_Retail_1: APR_NavData_Retail_1
# APR-TERRAIN-MOVES-END

ignore:
  # Repository metadata, local environments and developer tooling.
  - .github
  - .githooks
  - .vscode
  - .cache
  - .venv
  - .release
  - .editorconfig
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - .env
  - docs
  - tools
  - tests
  - Update-Libraries.cmd
  - NavigationData/manifest.json

  # Documentation is kept in the repository, not loaded by the addon.
  - README.md
  - SECURITY.md
  - wiki.md
  - readme
  - APR-Core/README.md
  - APR-Core/libs/LibAPRNavigation-1.0/README.md

  # Embedded libraries load through XML; their standalone TOCs/logo are unused.
  - "APR-Core/libs/*.toc"

  # Vendored optional modules absent from the runtime TOC/XML include graph.
  - APR-Core/libs/AceBucket-3.0
  - APR-Core/libs/AceHook-3.0
  - APR-Core/libs/AceTab-3.0
  - APR-Core/libs/AceTimer-3.0
  - APR-Core/libs/HereBeDragons/HereBeDragons-Migrate.lua

  # Runtime icons are the generated TGA files. Retain the source licenses.
  - "APR-Core/assets/ui/mdi/*.svg"
  - APR-Core/assets/ui/mdi/manifest.json
